# 百炼平台配置
# 请到 https://dashscope.console.aliyun.com/ 获取您的API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型配置
# 可选值: qwen-turbo, qwen-plus, qwen-max 等
MODEL_NAME=qwen-turbo

# API调用参数
TEMPERATURE=0.7
MAX_TOKENS=2000

# 向量数据库配置
# 向量数据库存储路径
FAISS_DB_PATH=./faiss_db

# 文件上传配置
# 上传文件存储路径
UPLOAD_DIR=./uploads

# 文本分割配置
# 文本块大小（字符数）
CHUNK_SIZE=1000
# 文本块重叠大小（字符数）
CHUNK_OVERLAP=200

# 服务器配置
# 服务端口号
PORT=8000
# 服务主机地址
HOST=0.0.0.0

# CORS配置
# 允许的源地址，多个地址用逗号分隔，例如: http://localhost:3000,http://localhost:5173
# 设置为 * 表示允许所有源（仅用于开发环境）
CORS_ORIGINS=*

# 日志级别
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
